{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    {{ if eq .Site.Language.Lang "ar" }}
    <description>آخر الاخبار والإعلانات على موقع {{ .Site.Title }}</description>
    {{ else }}
    <description>Recent news and announcements on {{ .Site.Title }}</description>
    {{ end }}
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale | default "ar" }}</language>
    {{ with .Site.Copyright }}
    <copyright>{{ . }}</copyright>
    {{ end }}
    {{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{ end }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    
    {{/* Filter pages by checking if their path includes /news/ or /announcements/ */}}
    {{ $filteredPages := where .Site.RegularPages "Section" "media" }}
    {{ $newsAndAnnouncements := where $filteredPages ".RelPermalink" "like" "(news|announcements)" }}
    
    {{ range first 15 $newsAndAnnouncements }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | html }}</description>
    </item>
    {{ end }}
  </channel>
</rss>